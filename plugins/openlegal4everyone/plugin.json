{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "openlegal4everyone",
  "version": "1.0.1",
  "description": "Search, read, cite and compare governments' statutes, ordinances and precedents with provenance through the openlegal4everyone MCP server.",
  "author": {
    "name": "PublicData-stream",
    "url": "https://github.com/PublicData-stream"
  },
  "homepage": "https://github.com/PublicData-stream/openlegal4everyoneMCP/tree/main/plugins/openlegal4everyone",
  "repository": "https://github.com/PublicData-stream/openlegal4everyoneMCP",
  "license": "AGPL-3.0-only",
  "keywords": ["legal", "korea", "law", "statute", "precedent", "mcp"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "openlegal4everyone",
        "shortDescription": "Gov legal info with provenance",
        "longDescription": "Search the openlegal4everyone MCP corpus of governments' statutes, ordinances and precedents, read exact text with source and freshness metadata, compare versions, and compare supplied texts. Legal information, not legal advice.",
        "developerName": "PublicData-stream",
        "category": "Education & Research",
        "brandColor": "#2357C6",
        "brandColorDark": "#8CB4FF",

        "composerIcon": "./logo.svg",
        "composerIconDark": "./logo.svg",

        "logo": "./logo.svg",
        "logoDark": "./logo.svg",
        "capabilities": ["Read"],
        "websiteURL": "https://publicdata.stream/servers/openlegal4everyonemcp/",
        "supportURL": "https://publicdata.stream/servers/openlegal4everyonemcp/",
        "privacyPolicyURL": "https://publicdata.stream/servers/openlegal4everyonemcp/privacy",
        "termsOfServiceURL": "https://publicdata.stream/servers/openlegal4everyonemcp/terms",
        "defaultPrompt": [
          "민법 제750조 원문을 출처와 함께 보여줘",
          "근로기준법 최근 개정에서 바뀐 조문을 비교해줘",
          "이 두 계약서 초안의 차이를 정리해줘"
        ]
      }
    }
  }
}
